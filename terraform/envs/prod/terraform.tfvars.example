# runtime_enabled / db_snapshot_identifier / db_final_snapshot_identifier は
# **このファイルに書かないこと**。稼働と停止はサイクルごとにコマンドラインで明示する:
#
#   terraform apply -var runtime_enabled=true  -var db_snapshot_identifier=... \
#                   -var db_final_snapshot_identifier=...
#   terraform apply -var runtime_enabled=false
#
# tfvars に固定すると、素の `terraform apply` が意図せず課金を始めたり
# 稼働中の本番を落としたりする（どちらに固定しても片方の事故が起きる）。
#
# 同じ理由で `TF_VAR_runtime_enabled` もシェルや direnv に置かないこと。
# 既定値を置かないガードが塞ぐのは default と tfvars の 2 経路だけで、
# 環境変数は素通りする。`export TF_VAR_runtime_enabled=false` が残っていると、
# 以降の apply が無言で稼働中の本番を落とす。

# Public domain (Route 53 hosted zone / ACM / application URLs)
# 既定値は nokoroa.com。別ドメインで立てる場合のみ指定する。
# app_domain = "nokoroa.com"

# Docker Images (ECR URLs)
backend_image  = "YOUR_AWS_ACCOUNT_ID.dkr.ecr.ap-northeast-1.amazonaws.com/nokoroa-backend:latest"
frontend_image = "YOUR_AWS_ACCOUNT_ID.dkr.ecr.ap-northeast-1.amazonaws.com/nokoroa-frontend:latest"
ai_image       = "YOUR_AWS_ACCOUNT_ID.dkr.ecr.ap-northeast-1.amazonaws.com/nokoroa-ai:latest"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
google_client_id     = "YOUR_GOOGLE_CLIENT_ID"
google_client_secret = "YOUR_GOOGLE_CLIENT_SECRET"

# Gemini API key (https://aistudio.google.com/apikey)
gemini_api_key = "YOUR_GEMINI_API_KEY"
