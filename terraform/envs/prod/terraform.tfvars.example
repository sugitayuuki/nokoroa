# ここには「環境を通して変わらない値」だけを書く。
#
# runtime_enabled は書かない。毎回コマンドラインで明示する（terraform apply -var runtime_enabled=true）。
# 固定すると素の apply が意図せず課金を始めるか、稼働中の本番を落とす。
# 同じ理由で `TF_VAR_runtime_enabled` もシェルや direnv に置かないこと。既定値を置かない
# ガードが塞ぐのは default と tfvars の 2 経路だけで、環境変数は素通りする。
#
# db_snapshot_identifier / db_final_snapshot_identifier も書かない。
# これはサイクルごとに変わる値なので cycle.auto.tfvars.example を使う。

# Public domain (Route 53 hosted zone / ACM / application URLs)
# 既定値は nokoroa.com。別ドメインで立てる場合のみ指定する。
# app_domain = "nokoroa.com"

# Docker Images (ECR URLs)
backend_image  = "YOUR_AWS_ACCOUNT_ID.dkr.ecr.ap-northeast-1.amazonaws.com/nokoroa-backend:latest"
frontend_image = "YOUR_AWS_ACCOUNT_ID.dkr.ecr.ap-northeast-1.amazonaws.com/nokoroa-frontend:latest"
ai_image       = "YOUR_AWS_ACCOUNT_ID.dkr.ecr.ap-northeast-1.amazonaws.com/nokoroa-ai:latest"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
google_client_id     = "YOUR_GOOGLE_CLIENT_ID"
google_client_secret = "YOUR_GOOGLE_CLIENT_SECRET"

# Gemini API key (https://aistudio.google.com/apikey)
gemini_api_key = "YOUR_GEMINI_API_KEY"
