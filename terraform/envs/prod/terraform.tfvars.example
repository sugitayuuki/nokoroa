# ここには「環境を通して変わらない値」だけを書く。
#
# runtime_enabled は書かない。毎回コマンドラインで明示する（terraform apply -var runtime_enabled=true）。
# 固定すると素の apply が意図せず課金を始めるか、稼働中の本番を落とす。
# 同じ理由で `TF_VAR_runtime_enabled` もシェルや direnv に置かないこと。既定値を置かない
# ガードが塞ぐのは default と tfvars の 2 経路だけで、環境変数は素通りする。
#
# db_start_from_empty も書かない。消し忘れが残ると、復元元の指定忘れを
# precondition が検知できなくなる（TF_VAR_db_start_from_empty も同じ理由で使わない）。
#
# db_snapshot_identifier / db_final_snapshot_identifier も書かない。
# これはサイクルごとに変わる値なので cycle.auto.tfvars.example を使う。

# Public domain (Route 53 hosted zone / ACM / application URLs)
# 既定値は nokoroa.com。別ドメインで立てる場合のみ指定する。
# app_domain = "nokoroa.com"

# Docker Images (ECR URLs)
# 既定でコメントアウトしている。イメージを push したあと（再構築の手順 4）に
# 実際の URL を入れて有効化する。
#
# プレースホルダのまま有効にしないこと。modules/ecs の precondition は空文字しか
# 弾けないので、"YOUR_AWS_ACCOUNT_ID..." のままだと plan を通過し、存在しない
# レジストリを指すタスク定義が作られて CannotPullContainerError を繰り返す。
# backend_image  = "<account-id>.dkr.ecr.ap-northeast-1.amazonaws.com/nokoroa-backend:latest"
# frontend_image = "<account-id>.dkr.ecr.ap-northeast-1.amazonaws.com/nokoroa-frontend:latest"
# ai_image       = "<account-id>.dkr.ecr.ap-northeast-1.amazonaws.com/nokoroa-ai:latest"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
google_client_id     = "YOUR_GOOGLE_CLIENT_ID"
google_client_secret = "YOUR_GOOGLE_CLIENT_SECRET"

# Gemini API key (https://aistudio.google.com/apikey)
# --- AI プロバイダ ---
# chat_provider:      gemini | claude
# embedding_provider: gemini | openai
# 使うプロバイダの鍵だけ設定する。未使用の鍵は空のままでよい。
#
# ★ embedding_provider を変えたら、デプロイ後に必ず全投稿の再埋め込みが必要。
#   プロバイダごとにベクトル空間が異なり、新旧が混在すると類似度検索が
#   意味を成さなくなる:
#     cd nokoroa-backend && npm run backfill:embeddings -- --all
chat_provider      = "claude"
embedding_provider = "openai"

# --- 意味検索とチャットの足切り ---
# 類似度がこの値未満の投稿は検索結果に出さない (0〜1)。
# ★ 同じ値が AI チャットの参照投稿の選別にも効く。チャットでは下限以上の
#   候補が 1 件も無いときだけキーワード検索へ落ち、余った枠を下限未満の
#   候補で埋める。効き具合は「Chat vector search: none of …」のログで、
#   実効値は起動時の「RAG min similarity: …」で確認できる。
#   チャットの入力は検索クエリより長い会話文で類似度が低めに出るため、
#   本番の分布を見て別値が要ると分かったら、専用の変数へ分けること。
# 適正値は投稿データの分布で変わる。本番の実測では
# 完全一致=0.73 / 関連あり=0.44 / 無関係=0.33〜0.36 だったため 0.4 が既定。
# 下げるとハズレが混ざり、上げると「関連が薄い」扱いが増える。
# 0 を入れると足切りを完全に無効化する(逃げ道。起動ログに警告が出る)。
# この値を超える投稿が 1 件も無いときは 0 件にせず、上位 3 件を
# 「関連が薄いかもしれません」と断って返す。閾値を外しても主要導線が
# 無言で 0 件にならないようにするため。効き具合は
# 「Semantic search cut …」のログで確認できる。
#
# ★ embedding_provider を変えたらこの値も実測し直すこと。
#   プロバイダが変わると類似度の分布ごと変わるため、同じ 0.4 が
#   「ほぼ全件0件」にも「足切りが実質無効」にも化ける。
#
# ★ この値は terraform apply だけでは反映されない。
#   ECS サービスは lifecycle.ignore_changes = [task_definition] を持つため、
#   apply は新しいタスク定義リビジョンを登録するだけで、稼働中のタスクは
#   古い値を使い続ける(エラーも差分も出ないので気づけない)。
#   apply のあとに必ずデプロイワークフローを流すこと。deploy.yml は
#   ファミリ名で最新リビジョンを引くので、新しい値がそのまま載る。
#   急ぐ場合のみ: aws ecs update-service --task-definition <新リビジョン>
semantic_min_similarity = 0.4

gemini_api_key    = ""
anthropic_api_key = "YOUR_ANTHROPIC_API_KEY"
openai_api_key    = "YOUR_OPENAI_API_KEY"
