# Public domain (Route 53 hosted zone / ACM / application URLs)
# 既定値は nokoroa.com。別ドメインで立てる場合のみ指定する。
# app_domain = "nokoroa.com"

# Docker Images (ECR URLs)
backend_image  = "YOUR_AWS_ACCOUNT_ID.dkr.ecr.ap-northeast-1.amazonaws.com/nokoroa-backend:latest"
frontend_image = "YOUR_AWS_ACCOUNT_ID.dkr.ecr.ap-northeast-1.amazonaws.com/nokoroa-frontend:latest"
ai_image       = "YOUR_AWS_ACCOUNT_ID.dkr.ecr.ap-northeast-1.amazonaws.com/nokoroa-ai:latest"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
google_client_id     = "YOUR_GOOGLE_CLIENT_ID"
google_client_secret = "YOUR_GOOGLE_CLIENT_SECRET"

# Gemini API key (https://aistudio.google.com/apikey)
# --- AI プロバイダ ---
# chat_provider:      gemini | claude
# embedding_provider: gemini | openai
# 使うプロバイダの鍵だけ設定する。未使用の鍵は空のままでよい。
#
# ★ embedding_provider を変えたら、デプロイ後に必ず全投稿の再埋め込みが必要。
#   プロバイダごとにベクトル空間が異なり、新旧が混在すると類似度検索が
#   意味を成さなくなる:
#     cd nokoroa-backend && npm run backfill:embeddings -- --all
chat_provider      = "claude"
embedding_provider = "openai"

gemini_api_key    = ""
anthropic_api_key = "YOUR_ANTHROPIC_API_KEY"
openai_api_key    = "YOUR_OPENAI_API_KEY"
