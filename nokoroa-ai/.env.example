# チャットと埋め込みは別々に選ぶ。Claude には埋め込み API が無いため、
# 1 つの設定では「チャットは Claude・検索は OpenAI」を表せない。
#
# CHAT_PROVIDER:
#   gemini … Google検索グラウンディングが使える唯一の経路。最新情報に強い。
#   claude … 外部APIへ従量課金。チャットのみ。
#   ollama … ローカル推論で課金ゼロ。いずれも検索グラウンディングは使えないため、
#            営業時間・料金などは学習時点の情報になる。
CHAT_PROVIDER=gemini
# EMBEDDING_PROVIDER: gemini | openai | ollama
EMBEDDING_PROVIDER=gemini

# ★ 選んだプロバイダのぶんだけ必須（未設定だと起動時に失敗する）。
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# backend の INTERNAL_AI_TOKEN と同じ値を設定する。
# 未設定の場合、全エンドポイントが 503 を返します。
INTERNAL_AI_TOKEN=dev-internal-token

# 使用する Gemini モデル（省略時は下記の既定値）。
# Gemini のモデルは定期的に shutdown されるため、失効時はここで差し替える。
# https://ai.google.dev/gemini-api/docs/deprecations
CHAT_MODEL=gemini-3.8-flash

# ★ EMBEDDING_MODEL を変更したら、必ず全投稿の再埋め込みが必要です。
#   モデルごとにベクトル空間が異なるため、新旧のベクトルが同じ列に混在すると
#   類似度検索の結果が意味を成しません。
#   cd nokoroa-backend && npm run backfill:embeddings -- --all
EMBEDDING_MODEL=gemini-embedding-001
# pgvector の HNSW インデックス上限（2000次元）と DB スキーマ vector(768) の都合で 768 固定。
# 変更する場合はマイグレーションと全投稿の再埋め込みが必要。
EMBEDDING_DIM=768

# --- CHAT_PROVIDER=claude のときだけ使う設定 ---
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# --- EMBEDDING_PROVIDER=openai のときだけ使う設定 ---
# dimensions 指定に対応したモデルであること。未対応だと 1536 次元が返り、
# EMBEDDING_DIM=768 との不一致で弾かれる。
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- ollama を選んだときだけ使う設定 ---
# 事前に `ollama pull <モデル名>` が必要。
OLLAMA_BASE_URL=http://localhost:11434
# 既定を 7B にしているのは速度のため。backend は 60 秒でストリームを打ち切るので、
# 大きいモデルほど初回ロードと生成で上限に触れやすい。
OLLAMA_CHAT_MODEL=qwen2.5:7b
# ★ CHAT_MODEL と同じく、埋め込みモデルを変えたら全投稿の再埋め込みが必要です。
#   gemini-embedding-001 と nomic-embed-text はベクトル空間が異なるため、
#   プロバイダを切り替えた場合も作り直してください。
#   cd nokoroa-backend && npm run backfill:embeddings -- --all
# nomic-embed-text の出力は 768 次元で EMBEDDING_DIM と一致する。
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
