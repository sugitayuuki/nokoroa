# フロントエンドのローカル用設定。`cp .env.local.example .env.local` して使う。
#
# NEXT_PUBLIC_* は Next.js がビルド時にバンドルへ埋め込む。実行時の環境変数では
# 上書きできないため、値を変えたら dev サーバを起動し直すこと。
# 本番の値は ECS のタスク定義ではなく .github/workflows/deploy.yml の build-args 側にある。

# バックエンドの URL。docker compose の既定ポート。
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google Maps の API キー。地図を使わないなら空のままで良い。
# 空文字または development_mode なら地図なし表示へフォールバックする。
# 他のダミー文字列を入れると壊れた地図になるので注意。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
