# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nokoroa_db"

# 実行環境 (production 指定時は S3 と FRONTEND_URL が必須になります)
NODE_ENV="development"
PORT=4000

# JWT (必須: 未設定 / 32文字未満だとアプリは起動しません)
# 生成例: openssl rand -base64 32
JWT_SECRET="replace-me-with-a-32-plus-character-random-secret"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# Frontend URL (本番では必須。未設定だと起動しません)
FRONTEND_URL="http://localhost:3000"

# アップロード画像のURL生成に使う自身の公開URL (開発時は省略可)
BACKEND_URL="http://localhost:4000"

# AI Service (AIチャット / ベクトル検索)
AI_SERVICE_URL="http://localhost:8000"
# nokoroa-ai の INTERNAL_API_KEY と同じ値を設定する。
# 不一致・未設定の場合、埋め込み生成とベクトル検索は無効になります。
INTERNAL_AI_TOKEN="your-internal-ai-token"

# AWS (開発時は不要。開発環境では画像をローカルの uploads/ に保存します)
AWS_REGION="ap-northeast-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# 変数名に注意: コードが読むのは AWS_BUCKET_NAME です (S3_BUCKET_NAME ではない)
AWS_BUCKET_NAME="your-s3-bucket"