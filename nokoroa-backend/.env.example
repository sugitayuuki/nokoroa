# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nokoroa_db"

# JWT (必須: 未設定だとアプリは起動しません)
# 生成例: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-key"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# AI Service (AIチャット / ベクトル検索)
AI_SERVICE_URL="http://localhost:8000"
# nokoroa-ai の INTERNAL_API_KEY と同じ値を設定する。
# 不一致・未設定の場合、埋め込み生成とベクトル検索は無効になります。
INTERNAL_AI_TOKEN="your-internal-ai-token"

# AWS (Optional)
AWS_REGION="ap-northeast-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
S3_BUCKET_NAME="your-s3-bucket"